# Ruta de la carpeta con las imágenes a procesar
TARGET_DIR='/home/heyker/Imágenes/codigos/consultorio 21'

# Ruta a los datos de idioma de Tesseract (por defecto en Arch Linux)
TESSDATA_PREFIX=/usr/share/tessdata

# Idioma para el reconocimiento ("eng", "spa", etc.)
OCR_LANG=eng

# Número máximo de imágenes procesadas en paralelo simultáneamente
MAX_CONCURRENT_TASKS=4

# Expresión regular para filtrar el código deseado
CODIGO_PATTERN=CON-[a-zA-Z0-9]+-[a-zA-Z0-9]+-[a-zA-Z0-9]+

# Factor para aumentar la saturación (ej. 20.0 o 30.0 para hacer los colores muy vivos)
ADJUST_CONTRASTE=35.0
